# Copiar a .env y completar. Nunca subir .env al repositorio.
# Los valores de abajo son los de Supabase local (`npm run db:start`); son públicos y solo sirven en tu máquina.

# --- Base de datos (Supabase / Postgres) ---
# Conexión directa a Postgres: la usan el worker y pg-boss.
# En Railway: la "Session pooler" o la conexión directa del proyecto de Supabase (puerto 5432, no el 6543 de transacciones).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase (web) ---
# Local: `npx supabase status` muestra las llaves.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (worker y rutas API). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (fase 8) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Shopify (fase 9) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- Meta: WhatsApp, Instagram, Messenger (fases 10 y 15) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
